<!doctype html>
<title>Snake</title>
<style>
body { margin: 0; font-family: sans-serif; background: #14231a; color: #e6f4ea; text-align: center; }
h1 { font-size: 40px; margin: 22px 0 4px; }
p { color: #9cc3a6; margin: 0 0 14px; }
#board { display: grid; grid-template-columns: repeat(16, 26px); gap: 2px; width: 446px; margin: 0 auto; background: #0c170f; padding: 6px; border-radius: 10px; }
.c { width: 26px; height: 26px; border-radius: 5px; background: #1c3324; }
.s { background: #5fd07a; } .h { background: #b6f5c4; } .f { background: #ff6b5c; border-radius: 13px; }
.bar { margin: 14px 0; font-size: 20px; }
button { background: #3fae5c; color: white; border: 0; border-radius: 18px; padding: 10px 22px; font-size: 16px; font-weight: bold; }
</style>
<h1>Snake</h1>
<p>Arrow keys (or W A S D) steer. Eat the red apples, don't bite yourself or hit the wall.</p>
<div id="board"></div>
<div class="bar">Score <b id="score">0</b> &nbsp; Best <b id="best">0</b> &nbsp; <span id="msg"></span></div>
<button id="go">New game</button>
<script>
const N = 16;
const board = document.getElementById('board');
const cells = [];
for (let i = 0; i < N * N; i++) { const d = document.createElement('div'); d.className = 'c'; board.appendChild(d); cells.push(d); }
let snake, dir, next, food, score, alive, waiting, timer;
let best = Number(localStorage.getItem('snake-best') || 0);
document.getElementById('best').textContent = best;
function place() {
  do { food = Math.floor(Math.random() * N * N); } while (snake.includes(food));
}
function draw() {
  const shown = new Array(N * N).fill('c');
  snake.forEach((p, i) => { shown[p] = i === 0 ? 'c h' : 'c s'; });
  shown[food] = 'c f';
  cells.forEach((c, i) => { if (c.className !== shown[i]) c.className = shown[i]; });
  document.getElementById('score').textContent = score;
}
function step() {
  if (!alive || waiting) return;
  dir = next;
  const head = snake[0];
  let x = head % N, y = Math.floor(head / N);
  x += dir[0]; y += dir[1];
  const p = y * N + x;
  if (x < 0 || y < 0 || x >= N || y >= N || snake.includes(p)) {
    alive = false;
    document.getElementById('msg').textContent = 'Game over!';
    if (score > best) { best = score; localStorage.setItem('snake-best', best); document.getElementById('best').textContent = best; }
    return;
  }
  snake.unshift(p);
  if (p === food) { score++; place(); } else snake.pop();
  draw();
}
function start() {
  snake = [N * 8 + 6, N * 8 + 5, N * 8 + 4];
  dir = next = [1, 0];
  score = 0; alive = true; waiting = true;
  document.getElementById('msg').textContent = 'Press an arrow key to start';
  place(); draw();
  clearInterval(timer);
  timer = setInterval(step, 170);
}
document.addEventListener('keydown', e => {
  const k = e.key.toLowerCase();
  const want = { arrowup: [0, -1], w: [0, -1], arrowdown: [0, 1], s: [0, 1], arrowleft: [-1, 0], a: [-1, 0], arrowright: [1, 0], d: [1, 0] }[k];
  if (want && (want[0] !== -dir[0] || want[1] !== -dir[1])) {
    next = want; e.preventDefault();
    if (waiting) { waiting = false; document.getElementById('msg').textContent = ''; }
  }
  if (k === ' ' && !alive) start();
});
document.getElementById('go').addEventListener('click', start);
start();
</script>
