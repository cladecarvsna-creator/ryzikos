<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<title>3D Куб</title>
<style>
body { 
  margin: 0; 
  font-family: sans-serif; 
  background: #f4f1ea; 
  color: #2a2620; 
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 100vh;
}
.card { 
  width: 560px; 
  background: white; 
  border-radius: 16px; 
  border: 1px solid #e4ddcf; 
  padding: 24px 28px; 
  box-shadow: 0 10px 25px rgba(0,0,0,0.05);
  text-align: center;
}
h1 { font-size: 30px; margin: 0 0 4px; }
p { color: #7a7266; margin: 0 0 18px; }

/* Сцена для 3D куба */
.scene {
  width: 100%;
  height: 300px;
  perspective: 600px;
  display: flex;
  justify-content: center;
  align-items: center;
  background: #faf8f5;
  border-radius: 12px;
  border: 1px solid #f0ebe1;
  margin-bottom: 16px;
  cursor: grab;
}
.scene:active { cursor: grabbing; }

.cube {
  width: 120px;
  height: 120px;
  position: relative;
  transform-style: preserve-3d;
  transform: rotateX(-20deg) rotateY(-30deg);
}

.face {
  position: absolute;
  width: 120px;
  height: 120px;
  border: 2px solid rgba(255,255,255,0.6);
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24px;
  font-weight: bold;
  color: white;
  user-select: none;
  box-shadow: inset 0 0 15px rgba(0,0,0,0.1);
}

/* Грани куба */
.front  { background: #e0892b; transform: translateZ(60px); }
.back   { background: #d0751a; transform: rotateY(180deg) translateZ(60px); }
.right  { background: #f09b3c; transform: rotateY(90deg) translateZ(60px); }
.left   { background: #c2670e; transform: rotateY(-90deg) translateZ(60px); }
.top    { background: #ffa94d; transform: rotateX(90deg) translateZ(60px); }
.bottom { background: #a85205; transform: rotateX(-90deg) translateZ(60px); }

.controls {
  display: flex;
  gap: 8px;
  justify-content: center;
}
button { 
  background: #e0892b; 
  color: white; 
  border: 0; 
  border-radius: 10px; 
  padding: 10px 18px; 
  font-size: 15px; 
  font-weight: bold; 
  cursor: pointer;
  transition: background 0.2s;
}
button:hover { background: #d0751a; }
.foot { color: #7a7266; margin-top: 14px; font-size: 14px; }
</style>
</head>
<body>

<div class="card">
  <h1>3D Куб</h1>
  <p>Кликайте и тяните мышкой по области куба, чтобы вращать его.</p>
  
  <div class="scene" id="scene">
    <div class="cube" id="cube">
      <div class="face front">1</div>
      <div class="face back">2</div>
      <div class="face right">3</div>
      <div class="face left">4</div>
      <div class="face top">5</div>
      <div class="face bottom">6</div>
    </div>
  </div>

  <div class="controls">
    <button id="spinBtn">Авто-вращение: Вкл</button>
    <button id="resetBtn">Сбросить вид</button>
  </div>
  
  <div class="foot" id="foot">Крутите куб во всех направлениях!</div>
</div>

<script>
const scene = document.getElementById('scene');
const cube = document.getElementById('cube');
const spinBtn = document.getElementById('spinBtn');
const resetBtn = document.getElementById('resetBtn');

let isDragging = false;
let startX = 0, startY = 0;
let rotX = -20, rotY = -30;
let autoSpin = true;
let animationId = null;

// Обновление положения куба
function updateCubeTransform() {
  cube.style.transform = `rotateX(${rotX}deg) rotateY(${rotY}deg)`;
}

// Мышь / Тач управление
scene.addEventListener('mousedown', (e) => {
  isDragging = true;
  startX = e.clientX;
  startY = e.clientY;
  autoSpin = false;
  spinBtn.textContent = 'Авто-вращение: Выкл';
});

window.addEventListener('mousemove', (e) => {
  if (!isDragging) return;
  const deltaX = e.clientX - startX;
  const deltaY = e.clientY - startY;
  
  rotY += deltaX * 0.5;
  rotX -= deltaY * 0.5;
  
  startX = e.clientX;
  startY = e.clientY;
  
  updateCubeTransform();
});

window.addEventListener('mouseup', () => {
  isDragging = false;
});

// Анимация авто-вращения
function animate() {
  if (autoSpin) {
    rotY += 0.5;
    rotX += 0.3;
    updateCubeTransform();
  }
  animationId = requestAnimationFrame(animate);
}
animate();

// Кнопки управления
spinBtn.addEventListener('click', () => {
  autoSpin = !autoSpin;
  spinBtn.textContent = 'Авто-вращение: ' + (autoSpin ? 'Вкл' : 'Выкл');
});

resetBtn.addEventListener('click', () => {
  autoSpin = false;
  spinBtn.textContent = 'Авто-вращение: Выкл';
  rotX = -20;
  rotY = -30;
  updateCubeTransform();
});
</script>

</body>
</html>
